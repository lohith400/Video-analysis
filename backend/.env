# Copy to .env (or export these before running server.py / uvicorn).
# Loaded automatically if you install python-dotenv (see requirements.txt).

# Shared secret required on /upload, /connect, /stop and the WebSocket.
# Leave blank for local dev — server.py will print a loud warning instead
# of silently running unauthenticated.
IRIS_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# Falls back to "*" (any origin) if unset — fine for local dev only.
IRIS_CORS_ORIGINS=http://localhost:3000
