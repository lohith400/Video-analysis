# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── ML Models & Weights (Ignore all large model files recursively) ─────────
*.pt
*.pth
*.onnx
*.weights
*.bin
yolov8n.pt
yolo26n.pt
yolo*.pt
# Keep models/ folder structure but ignore all weights inside it
!models/
models/*
!models/.gitkeep

# ── Datasets (Ignore entire dataset folders) ──────────────────────────────
plate_dataset/
dataset/
runs/

# ── Uploaded videos / images ───────────────────────────────────────────────
uploads/
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
*.bmp

# ── Generated data / Logs ──────────────────────────────────────────────────
traffic_log.csv
*.csv
*.log
logs/
train_error.log

# ── Frontend build & deps ──────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/

# ── Zone.Identifier files (Windows WSL artefacts) ─────────────────────────
*Zone.Identifier
**/*Zone.Identifier
**/*:Zone.Identifier

# ── IDE / OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
